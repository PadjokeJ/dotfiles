// -*- mode: jsonc -*-
[
    {
        "reload_style_on_change": true,
        "layer": "top",
        "position": "top",
        "height": 30, 
        "spacing": 0,
        "modules-left": [
            "custom/power"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "pulseaudio",
            "network",
            "backlight",
            "custom/updates",
            "power-profiles-daemon",
            "tray",
            "battery"
        ],
        "tray": {
            "spacing": 10
        },
        "clock": {
            "format": "{:%B %d %H:%M}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "format-alt": "{:%Y-%m-%d}"
        },
        "backlight": {
            "format": "{icon}",
            "tooltip-format": "{percent}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                ""
            ]
        },
        "battery": {
            "states": {
                // "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-full": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": "{icon} {capacity}%",
            "format-alt": "{time} {icon}",
            // "format-good": "", // An empty format will hide the module
            // "format-full": "",
            "format-icons": [
                "󰂃",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "power-profiles-daemon": {
            "format": " {icon} ",
            "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
            "tooltip": true,
            "format-icons": {
                "default": " ",
                "performance": "󰓅 ",
                "balanced": " ",
                "power-saver": "󰚦 "
            }
        },
        "network": {
            "format-wifi": "{icon}",
            "format-icons": [
                "󰤯 ",
                "󰤟 ",
                "󰤢 ",
                "󰤥 ",
                "󰤨 "
            ],
            "format-ethernet": "ETH",
            "tooltip-format": "{gwaddr} 󰈀",
            "format-linked": "",
            "format-disconnected": "   ",
            "format-alt": " {ipaddr}/{cidr}"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "{volume}% {icon}",
            "format-bluetooth-muted": " {icon}",
            "format-muted": " {format_source}",
            "format-source": "{volume}% 󰍬",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "HPH",
                "hands-free": "HFR",
                "headset": "HST",
                "phone": "PHN",
                "portable": "POR",
                "car": "CAR",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "~/.config/waybar/scripts/vol.sh"
        },
        "custom/updates": {
            "format": " {text}",
            "return-type": "json",
            "tooltip-format": "{alt}",
            "interval": 300,
            "exec": "~/.config/waybar/scripts/updates.sh"
        },
        "custom/right-arrow": {
            "format": "",
            "tooltip": false
        },
        "custom/left-inverse-arrow": {
            "format": "",
            "tooltip": false
        },
        "custom/right-inverse-arrow": {
            "format": "",
            "tooltip": false
        },
        "custom/left-arrow": {
            "format": "",
            "tooltip": false
        },
        "custom/power": {
            "format": "⏻ ",
            "tooltip": false,
            "on-click": "~/.config/waybar/scripts/power.sh"
        }
    },
  {
        "reload_style_on_change": true,
        "layer": "top",
        "position": "left",
        "width": 2, 
        "spacing": 0,
  },
  {
        "reload_style_on_change": true,
        "layer": "top",
        "position": "right",
        "width": 2, 
        "spacing": 0,
  },

  {
        "reload_style_on_change": true,
        "layer": "top",
        "position": "bottom",
        "height": 2, 
        "spacing": 0,
  }
]
